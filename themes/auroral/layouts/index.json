{{- $items := slice }}
{{- /* One index per language (/index.json, /zh/index.json). Posts that are not translated yet are
       included from the other language, labelled with their language. */}}
{{- range partial "i18n/pages.html" (dict "sections" (slice "blog" "interactive" "projects")) }}
{{- $text := .Plain }}
{{- /* Interactive posts: search the text of the embedded HTML page too. */}}
{{- if eq .Section "interactive" }}{{ with .Resources.GetMatch (.Params.html | default "*.html") }}
{{- $body := .Content | replaceRE `(?is)<(script|style)\b.*?</(script|style)>|<!doctype[^>]*>` " " | plainify | replaceRE `\s+` " " }}
{{- $text = printf "%s %s" $text $body }}
{{- end }}{{ end }}
{{- $items = $items | append (dict
  "title" .Title
  "url" .RelPermalink
  "section" (cond (eq .Section "blog") (i18n "sectionPost") (cond (eq .Section "interactive") (i18n "sectionInteractive") (i18n "sectionProject")))
  "lang" (cond (eq .Language.Lang site.Language.Lang) "" (.Language.LanguageCode | default .Language.Lang))
  "langLabel" (cond (eq .Language.Lang site.Language.Lang) "" (.Site.Params.langLabel | default (upper .Language.Lang)))
  "date" (cond .Date.IsZero "" (.Date | time.Format (site.Params.dateFormatMedium | default "2 Jan 2006")))
  "summary" (.Description | default .Summary | plainify | htmlUnescape | replaceRE `\s?\[@[^\[\]]+\]` "" | truncate 220 | htmlUnescape)
  "tags" (.Params.tags | default slice)
  "content" ($text | htmlUnescape | truncate 5000 | htmlUnescape)
) }}
{{- end }}
{{- $items | jsonify }}
